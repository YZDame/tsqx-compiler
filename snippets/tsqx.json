{
  "Basic triangle": {
    "prefix": "tsqx-triangle",
    "body": [
      "~triangle ${1:A} ${2:B} ${3:C}",
      "",
      "${1:A}--${2:B}--${3:C}--cycle / ${4:0.10 lightcyan} / ${5:blue}"
    ],
    "description": "Create and draw a basic TSQX triangle",
    "category": "Starting Shapes"
  },
  "Regular polygon": {
    "prefix": "tsqx-regular",
    "body": [
      "~regular ${1:A} ${2:B} ${3:C} ${4:D} ${5:E}",
      "${1:A}--${2:B}--${3:C}--${4:D}--${5:E}--cycle / ${6:blue}"
    ],
    "description": "Define five equally spaced vertices and draw the polygon",
    "category": "Starting Shapes"
  },
  "Point definition": {
    "prefix": "tsqx-point",
    "body": "${1:P} ${2:45} = ${3:dir 90}",
    "description": "Define a labeled TSQX point",
    "category": "Points & Intersections"
  },
  "Point at coordinates": {
    "prefix": "tsqx-coords",
    "body": "${1:P} ${2:NE} = (${3:1}, ${4:2})",
    "description": "Define a point and set its label direction",
    "category": "Points & Intersections"
  },
  "Unmarked point": {
    "prefix": "tsqx-unmarked",
    "body": "${1:P} := (${2:1}, ${3:2})",
    "description": "Define a point with no dot or label",
    "category": "Points & Intersections"
  },
  "Midpoint": {
    "prefix": "tsqx-midpoint",
    "body": "${1:M} = midpoint ${2:A}--${3:B}",
    "description": "Define the midpoint of segment AB",
    "category": "Points & Intersections"
  },
  "Perpendicular foot": {
    "prefix": "tsqx-foot",
    "body": "${1:D} = foot ${2:P} ${3:A} ${4:B}",
    "description": "Define the perpendicular foot from P to AB",
    "category": "Points & Intersections"
  },
  "Intersection of two lines": {
    "prefix": "tsqx-intersection",
    "body": "${1:X} = extension ${2:A} ${3:B} ${4:C} ${5:D}",
    "description": "Find the intersection of lines AB and CD",
    "category": "Points & Intersections"
  },
  "Second circle-line intersection (otherPt)": {
    "prefix": "tsqx-otherpt",
    "body": "${1:K} ${2:270} = otherPt ${3:w} ${4:A} ${5:B}",
    "description": "Find the second intersection of line AB with circle w excluding A (ldgeo)",
    "category": "Points & Intersections"
  },
  "Perpendicular line intersection (perpPt)": {
    "prefix": "tsqx-perppt",
    "body": "${1:T} ${2:270} = extension ${3:P} (perpPt ${3:P} ${4:A} ${5:B}) ${6:C} ${7:D}",
    "description": "Intersect the perpendicular through P to AB with line CD (ldgeo)",
    "category": "Points & Intersections"
  },
  "Tangent point (tangentPt)": {
    "prefix": "tsqx-tangent",
    "body": "${1:T} ${2:90} = tangentPt ${3:P} ${4:O} ${5:A} ${6:1}",
    "description": "Find tangent point from P to circle centered at O through A (ldgeo)",
    "category": "Points & Intersections"
  },
  "Two path intersections": {
    "prefix": "tsqx-path-intersections",
    "body": [
      "${1:X} = IP (${3:Line A B}) (${4:unitcircle})",
      "${2:Y} = OP (${3:Line A B}) (${4:unitcircle})"
    ],
    "description": "Define both intersection points of two paths",
    "category": "Points & Intersections"
  },
  "Incenter": {
    "prefix": "tsqx-incenter",
    "body": "${1:I} = incenter ${2:A} ${3:B} ${4:C}",
    "description": "Define the incenter of triangle ABC",
    "category": "Triangle Centers & Circles"
  },
  "Circumcenter": {
    "prefix": "tsqx-circumcenter",
    "body": "${1:O} = circumcenter ${2:A} ${3:B} ${4:C}",
    "description": "Define the circumcenter of triangle ABC",
    "category": "Triangle Centers & Circles"
  },
  "Orthocenter": {
    "prefix": "tsqx-orthocenter",
    "body": "${1:H} = orthocenter ${2:A} ${3:B} ${4:C}",
    "description": "Define the orthocenter of triangle ABC",
    "category": "Triangle Centers & Circles"
  },
  "Centroid": {
    "prefix": "tsqx-centroid",
    "body": "${1:G} = centroid ${2:A} ${3:B} ${4:C}",
    "description": "Define the centroid of triangle ABC",
    "category": "Triangle Centers & Circles"
  },
  "Incircle": {
    "prefix": "tsqx-incircle",
    "body": "incircle ${1:A} ${2:B} ${3:C} / ${4:circ2}",
    "description": "Draw the incircle of triangle ABC",
    "category": "Triangle Centers & Circles"
  },
  "Circumcircle": {
    "prefix": "tsqx-circumcircle",
    "body": "circumcircle ${1:A} ${2:B} ${3:C} / ${4:circ}",
    "description": "Draw the circumcircle of triangle ABC",
    "category": "Triangle Centers & Circles"
  },
  "Circle through a point": {
    "prefix": "tsqx-circle-point",
    "body": "CP ${1:O} ${2:A} / ${3:circ}",
    "description": "Draw the circle centered at O through A",
    "category": "Triangle Centers & Circles"
  },
  "Circle with radius": {
    "prefix": "tsqx-circle-radius",
    "body": "CR ${1:O} ${2:1} / ${3:circ}",
    "description": "Draw the circle centered at O with a given radius",
    "category": "Triangle Centers & Circles"
  },
  "Themed triangle skeleton": {
    "prefix": "tsqx-themed-triangle",
    "body": [
      "~triangle ${1:A} ${2:B} ${3:C}",
      "",
      "circumcircle ${1:A} ${2:B} ${3:C} / circ",
      "${1:A}--${2:B}--${3:C}--cycle / fill1 / given"
    ],
    "description": "Create a theme-aware triangle with semantic ldgeo tokens",
    "category": "Starting Shapes"
  },
  "Styled segment": {
    "prefix": "tsqx-segment",
    "body": "${1:A}--${2:B} / ${3:aux}",
    "description": "Draw a segment with a semantic or explicit stroke",
    "category": "Drawing & Styling"
  },
  "Right-angle marker": {
    "prefix": "tsqx-rightangle",
    "body": "rightanglemark ${1:A} ${2:D} ${3:C} / mark",
    "description": "Draw a right-angle marker at vertex D (ldgeo)",
    "category": "Drawing & Styling"
  },
  "Angle arc marker": {
    "prefix": "tsqx-anglemark",
    "body": "anglemark ${1:B} ${2:A} ${3:C} / mark",
    "description": "Draw an angle arc marker at vertex A (ldgeo)",
    "category": "Drawing & Styling"
  },
  "Extended line": {
    "prefix": "tsqx-line",
    "body": "Line ${1:A} ${2:B} / ${3:aux}",
    "description": "Draw a line extending past A and B",
    "category": "Drawing & Styling"
  },
  "Filled polygon": {
    "prefix": "tsqx-fill",
    "body": "${1:A}--${2:B}--${3:C}--cycle / ${4:fill1} / ${5:given}",
    "description": "Draw a filled polygon with an outline",
    "category": "Drawing & Styling"
  },
  "Assert perpendicular": {
    "prefix": "tsqx-check-perp",
    "body": "!check_perp(${1:A}, ${2:D}, ${3:B}, ${4:C}, \"${5:AD perp BC}\");",
    "description": "Verify perpendicularity at compile time (ldgeo)",
    "category": "Drawing & Styling"
  },
  "Assert concyclic": {
    "prefix": "tsqx-check-cyclic",
    "body": "!check_cyclic(${1:A}, ${2:B}, ${3:C}, ${4:D}, \"${5:ABCD cyclic}\");",
    "description": "Verify four points are concyclic at compile time (ldgeo)",
    "category": "Drawing & Styling"
  },
  "Direct Asymptote": {
    "prefix": "tsqx-asy",
    "body": "!${1:draw((0,0)--(1,0));}",
    "description": "Insert a direct Asymptote command",
    "category": "Drawing & Styling"
  }
}
